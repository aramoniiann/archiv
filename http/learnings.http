@baseUrl = http://localhost:8000/api

### Login Demo
# @name login
POST {{baseUrl}}/auth/login
Accept: application/json
Content-Type: application/json

{
  "email": "demo@archiv.test",
  "password": "password"
}

### Login Other
# @name otherLogin
POST {{baseUrl}}/auth/login
Accept: application/json
Content-Type: application/json

{
  "email": "other@archiv.test",
  "password": "password"
}

###
@token = {{login.response.body.token}}
@otherToken = {{otherLogin.response.body.token}}

### Listar aprendizados
GET {{baseUrl}}/learnings
Accept: application/json
Authorization: Bearer {{token}}

### Criar aprendizado
# @name created
POST {{baseUrl}}/learnings
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Form Requests",
  "description": "Validação antes de chegar no controller.",
  "studied_at": "2026-11-16"
}

### Ver aprendizado
GET {{baseUrl}}/learnings/{{created.response.body.data.id}}
Accept: application/json
Authorization: Bearer {{token}}

### Atualizar aprendizado
PATCH {{baseUrl}}/learnings/{{created.response.body.data.id}}
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "learned"
}

### Excluir aprendizado
DELETE {{baseUrl}}/learnings/{{created.response.body.data.id}}
Accept: application/json
Authorization: Bearer {{token}}

### Status inválido (422)
POST {{baseUrl}}/learnings
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Teste",
  "status": "esquecido"
}

### Aprendizado de outro usuário (403)
GET {{baseUrl}}/learnings/1
Accept: application/json
Authorization: Bearer {{otherToken}}

